EVALUATE
TOPN(
    5,
    SELECTCOLUMNS(
        FILTER(Risques, Risques[ProjectRef] = "PRJ-2026-017" && Risques[Statut] = "Ouvert"),
        "RiskID", Risques[RiskID], "Risque", Risques[Risque],
        "Criticite", Risques[Criticite], "Owner", Risques[Owner],
        "Mitigation", Risques[Mitigation]
    ),
    [Criticite], DESC, [RiskID], ASC
)
ORDER BY [Criticite] DESC, [RiskID] ASC
